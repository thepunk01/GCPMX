[Unit]
Description=GCP IP Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gcp-ip-panel
Environment=GCP_MOCK=0
EnvironmentFile=-/opt/gcp-ip-panel/.env
ExecStart=/bin/bash /opt/gcp-ip-panel/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
